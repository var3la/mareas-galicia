---
import Base from '../layouts/Base.astro';
import PortCard from './PortCard.astro';
import Tabs from './Tabs.astro';
import { zones, type Zone } from '../lib/zones';
import { getMareas, windowAround } from '../lib/meteogalicia';
import { addDays, formatDayLong, isoToMinutes, nowMinutes } from '../lib/time';
import { tideStatus } from '../lib/tide';
import { href } from '../lib/paths';
import { cn } from '../lib/utils';
import { buttonVariants } from './ui/button';
import { badgeVariants } from './ui/badge';
import { alertVariants } from './ui/alert';

interface Props {
  zone: Zone;
  /** Día mostrado (YYYY-MM-DD). */
  day: string;
  /** Hoy en Galicia en el momento del build (YYYY-MM-DD). */
  today: string;
}

const { zone, day, today } = Astro.props;
const isToday = day === today;
const nowMin = nowMinutes();
const dayStart = isoToMinutes(day);

let error: string | null = null;
let ports: Awaited<ReturnType<typeof getMareas>> = new Map();
try {
  const { from, to } = windowAround(day);
  ports = await getMareas(from, to);
} catch (e) {
  error = e instanceof Error ? e.message : 'Erro descoñecido';
}

const zonePorts = zone.ports.map((id) => ports.get(id)).filter((p): p is NonNullable<typeof p> => !!p);
const statuses = zonePorts.map((p) => tideStatus(p.extremos, nowMin));
const rising = statuses.filter((s) => s.trend === 'subindo').length;
const falling = statuses.filter((s) => s.trend === 'baixando').length;

// Rutas estáticas: /<zona>/<YYYY-MM-DD>/ (hoy = /<zona>/<today>/).
const zoneHref = (slug: string, d = day) => href(`${slug}/${d}/`);
const dayHref = (d: string) => zoneHref(zone.slug, d);
const prevDay = addDays(day, -1);
const nextDay = addDays(day, 1);
const dayTitle = isToday ? 'Hoy' : formatDayLong(day);
const generatedAt = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' }).format(new Date());
---

<Base
  title={`Mareas · ${zone.name}`}
  description="Estado das mareas en cada zona da costa galega, con datos da predición oficial de MeteoGalicia."
>
  <div class="wrap">
    <Tabs active="mareas" />

    <header class="masthead">
      <p class="kicker">Costa gallega · Predicción de mareas</p>
      <h1 class="headline">Mareas</h1>
      <p class="deck">
        Pleamares, bajamares y altura estimada en cada punto da costa, actualizadas desde MeteoGalicia.
      </p>
    </header>

    <nav class="zones" aria-label="Zonas de Galicia">
      {zones.map((z, i) => (
        <a
          href={zoneHref(z.slug)}
          class:list={['zone', { 'zone--active': z.slug === zone.slug }]}
          aria-current={z.slug === zone.slug ? 'page' : undefined}
        >
          <span class="zone__index">{String(i + 1).padStart(2, '0')}</span>
          <span class="zone__name">{z.name}</span>
          <span class="zone__blurb">{z.blurb}</span>
        </a>
      ))}
    </nav>

    <section class="toolbar" aria-label="Día consultado">
      <div class="day">
        <a class={cn("day__btn", buttonVariants({ variant: "neutral", size: "icon" }))} href={dayHref(prevDay)} aria-label="Día anterior">←</a>
        <div class="day__current">
          <span class="day__label">{dayTitle}</span>
          {!isToday && <a class="day__today" href={zoneHref(zone.slug, today)}>Volver a hoy</a>}
        </div>
        <a class={cn("day__btn", buttonVariants({ variant: "neutral", size: "icon" }))} href={dayHref(nextDay)} aria-label="Día siguiente">→</a>
      </div>

      <p class="status-line" aria-live="polite">
        {isToday && statuses.length > 0 ? (
          <>
            <span class={cn("pill pill--flood", badgeVariants({ variant: "neutral" }))}>{rising} subiendo</span>
            <span class={cn("pill pill--ebb", badgeVariants({ variant: "neutral" }))}>{falling} bajando</span>
            <span class="muted">· {zone.name}</span>
          </>
        ) : (
          <span class="muted">{zone.name}</span>
        )}
      </p>
    </section>

    <main>
      {error && (
        <div class={cn("notice", alertVariants())} role="alert">
          <strong>No se pudo consultar MeteoGalicia.</strong>
          <span>{error}. Inténtalo de nuevo en unos minutos.</span>
        </div>
      )}

      {!error && zonePorts.length === 0 && (
        <div class={cn("notice", alertVariants())}>No hay datos de marea para esta zona este día.</div>
      )}

      <div class="grid">
        {zonePorts.map((porto) => (
          <PortCard porto={porto} dayStart={dayStart} nowMin={nowMin} isToday={isToday} />
        ))}
      </div>
    </main>

    <footer class="foot">
      <p>
        Datos: <a href="https://www.meteogalicia.gal/web/predicion/mareas-e-luas" target="_blank" rel="noopener">MeteoGalicia</a>.
        Las alturas entre pleamar y bajamar son interpolaciones orientativas; no las uses para navegar.
      </p>
      <p class="muted">Actualizado a las {generatedAt}. Caché de 15 minutos.</p>
    </footer>
  </div>
</Base>

<style>
  .masthead {
    padding: clamp(2.5rem, 7vw, 4.5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    gap: 0.6rem;
    border-bottom: 1px solid var(--rule-strong);
  }
  .kicker {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.5rem, 12vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .deck {
    margin: 0.4rem 0 0;
    max-width: 38rem;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--ink-soft);
  }

  .zones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    border-bottom: 1px solid var(--rule-strong);
  }
  .zone {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 1rem 1.2rem 0;
    text-decoration: none;
    color: var(--ink);
    transition: color 0.2s ease;
  }
  .zone + .zone { padding-left: 1rem; border-left: 1px solid var(--rule); }
  .zone::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--sea);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .zone:hover::after,
  .zone--active::after { transform: scaleX(1); }
  .zone--active .zone__name { color: var(--sea); }
  .zone:hover .zone__name { color: var(--sea); }
  .zone__index {
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }
  .zone__name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.1;
  }
  .zone__blurb {
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
  }
  .day {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .day__btn {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid var(--ink);
    border-radius: 0;
    box-shadow: var(--shadow);
    text-decoration: none;
    font-size: 1.1rem;
    background: var(--surface);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .day__btn:hover { background: var(--accent); color: var(--ink); }
  .day__current { display: grid; gap: 0.1rem; min-width: 12rem; }
  .day__label {
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-transform: capitalize;
  }
  .day__today {
    font-size: 0.8rem;
    color: var(--sea);
  }

  .status-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .pill {
    padding: 0.25rem 0.7rem;
    border-radius: 0;
    font-size: 0.85rem;
    font-weight: 600;
    border: 2px solid currentColor;
  }
  .pill--flood { color: var(--flood); }
  .pill--ebb { color: var(--ebb); }
  .muted { color: var(--ink-soft); font-size: 0.9rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 1.25rem;
    padding-bottom: 2.5rem;
  }

  .notice {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    border-left: 8px solid var(--ebb);
    background: var(--surface);
  }

  .foot {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .foot a { color: var(--sea); }

  @media (max-width: 560px) {
    .zone + .zone { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); }
    .zone { padding-right: 0; }
    .day__current { min-width: 0; flex: 1; text-align: center; }
    .day { width: 100%; justify-content: space-between; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>
